# Schulwissen-Plattform – Vorlage für .env
#
#   cp .env.example .env && nano .env
#   chmod 600 .env        # die Datei enthält Passwörter
#
# Pflichtwerte sind markiert. Alles andere hat sinnvolle Voreinstellungen.

# --- Pflicht ---------------------------------------------------------------

# Zufälliger Schlüssel, einmalig erzeugen mit: openssl rand -hex 32
SW_SECRET_KEY=

# Passwort der Datenbank, erzeugen mit: openssl rand -hex 24
# Nur Buchstaben und Ziffern verwenden, sonst stolpert die Verbindungs-URL.
POSTGRES_PASSWORD=

# Hostname(n), unter denen die App erreichbar ist, mit Komma getrennt.
SW_ALLOWED_HOSTS=schulwissen.ggs-ndk.de

# Vollständige Adresse ohne „/“ am Ende. Steht in den Links der Reset-Mails.
SW_OEFFENTLICHE_URL=https://schulwissen.ggs-ndk.de

# --- Optional --------------------------------------------------------------

# Nur für die Entwicklung auf true setzen. Im Echtbetrieb bleibt es leer.
SW_DEBUG=

# Setzt docker-compose.yml selbst. Nur bei Betrieb ohne Compose nötig.
# SW_DATABASE_URL=postgresql://schulwissen:PASSWORT@127.0.0.1:5432/schulwissen

# Ablage der hochgeladenen Anhänge. Setzt docker-compose.yml selbst.
# SW_MEDIEN_VERZEICHNIS=/medien

# Mailversand für „Passwort vergessen“. Ohne SW_SMTP_HOST landen die Mails
# nur im Protokoll (docker compose logs app) – zum Ausprobieren genügt das,
# für das Kollegium nicht.
SW_SMTP_HOST=
SW_SMTP_PORT=587
SW_SMTP_NUTZER=
SW_SMTP_PASSWORT=
SW_SMTP_TLS=true
SW_ABSENDER=schulwissen@ggs-ndk.de

# Adressen des vorgeschalteten Proxys. Nur ändern, wenn der App-Port
# nicht mehr auf 127.0.0.1 liegt.
SW_PROXY_IPS=*

# Port auf 127.0.0.1, auf dem die App lauscht. Ändern, wenn dort schon etwas
# läuft – die Fahrradprüfungs-App belegt zum Beispiel 8000.
SW_PORT=8001

# --- Nextcloud (optional) --------------------------------------------------
#
# Damit lassen sich Dateien aus der Nextcloud in Einträgen verlinken. Nötig ist
# ein eigenes technisches Konto mit einem App-Passwort (Nextcloud: Einstellungen
# → Sicherheit → App-Passwort erzeugen). Dieses Konto braucht nur Leserechte auf
# die Ordner, die das Kollegium verlinken soll.
#
# Bleiben die Werte leer, fehlt die Dateiauswahl – die App läuft trotzdem.
SW_NEXTCLOUD_URL=https://cloud.ggs-ndk.de
SW_NEXTCLOUD_NUTZER=
SW_NEXTCLOUD_PASSWORT=

# HSTS in Tagen: Der Browser merkt sich dann, dass es diese Adresse nur über
# HTTPS gibt. Erst einschalten, wenn HTTPS zuverlässig läuft – die Festlegung
# gilt im Browser für diese Dauer und lässt sich nicht zurücknehmen.
# 0 schaltet HSTS ab. Vorgabe im Echtbetrieb: 365.
SW_HSTS_TAGE=365
